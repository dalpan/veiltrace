{
  "manifest_version": 3,
  "name": "VeilTrace",
  "short_name": "VeilTrace",
  "version": "0.5.0",
  "description": "Uncover the manipulation behind the page. On-demand, offline detection of deceptive instructions such as fake CAPTCHA 'run this command' lures.",
  "minimum_chrome_version": "110",
  "action": {
    "default_title": "VeilTrace: scan this page",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["activeTab", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'none'; form-action 'none'"
  }
}
