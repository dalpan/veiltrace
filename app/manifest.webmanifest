{
  "name": "VeilTrace · Cek Pesan",
  "short_name": "VeilTrace",
  "description": "Check a suspicious message on your device, offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0d0f0d",
  "theme_color": "#141713",
  "lang": "id",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "image",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}
