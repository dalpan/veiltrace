{
  "name": "veiltrace",
  "version": "0.1.0",
  "private": true,
  "description": "Offline-first browser security engine for detecting contextual social engineering and deceptive instructions.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.extract.json && tsc --noEmit -p tsconfig.extension.json && tsc --noEmit -p tsconfig.pwa.json && tsc --noEmit -p tsconfig.sw.json && tsc --noEmit -p tests/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test",
    "eval": "node scripts/eval.mjs",
    "eval:cred": "node scripts/eval-cred.mjs",
    "eval:pay": "node scripts/eval-pay.mjs",
    "eval:support": "node scripts/eval-support.mjs",
    "realworld": "node scripts/realworld.mjs",
    "eval:v2": "node scripts/eval-v2.mjs",
    "build:ext": "node scripts/build-extension.mjs",
    "build:ext:test": "node scripts/build-extension.mjs --test",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build:firefox": "node scripts/build-extension.mjs --firefox",
    "build:managed": "node scripts/build-extension.mjs --managed",
    "test:unit": "vitest run --exclude 'tests/browser/**' --exclude 'tests/e2e/**'",
    "test:browser": "vitest run tests/browser",
    "test:e2e": "vitest run tests/e2e",
    "verify:extension": "npm run build:ext && vitest run tests/e2e/security.test.ts tests/architecture.test.ts tests/extension.test.ts",
    "manual:fixtures": "node scripts/manual-fixtures.mjs",
    "release": "node scripts/release.mjs --out release",
    "release:verify": "node scripts/verify-release.mjs release",
    "release:repro": "node scripts/repro-check.mjs",
    "supply-chain": "node scripts/supply-chain.mjs",
    "release:candidate": "node scripts/release.mjs --out release --candidate",
    "submission:pdf": "node scripts/submission-pdf.mjs",
    "submission:video": "VT_VIDEO_DIR=submission/dist/video vitest run tests/e2e/video.test.ts && node scripts/submission-video.mjs submission/dist/video",
    "deploy:pwa": "node scripts/deploy-pwa.mjs",
    "build:ai-eval": "node scripts/build-ai-eval.mjs",
    "build:ext:ai": "node scripts/build-extension.mjs --ai",
    "eval:v3": "node scripts/eval-v3.mjs",
    "brand": "node scripts/render-brand.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.5",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
